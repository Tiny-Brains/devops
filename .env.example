# Copy to .env and fill in. `docker compose` reads .env from this directory (devops/).
# The compose file refuses to start rather than defaulting any of these.

# ---- GitHub OAuth App --------------------------------------------------------
# Create at github.com/settings/developers -> New OAuth App:
#   Homepage URL                 http://localhost:5173
#   Authorization callback URL   http://localhost:5173/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Soma --------------------------------------------------------------------
# HS256 key for session tokens and the sign-in state cookie. At least 32 bytes;
# generate one:
#   openssl rand -hex 32
SOMA_SESSION_SECRET=

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=soma
POSTGRES_PASSWORD=
POSTGRES_DB=soma

# ---- Kalam and Axon ----------------------------------------------------------
# The engine digest. sha256 over kalam/plugins/tb-ants/tb-ants.wasm, and the one number
# three things must agree on -- the plugin Orion loads, [vars] engine_digest on the
# replica, and games.active_engine_digest that pair stamps on every row. A mismatch is
# not an error anywhere: the replica claims nothing, for ever, and the queue grows.
#
#   kalam/scripts/vendor-engine.sh      # prints it
#   devops/scripts/engine-digest.sh     # writes it into the database
KALAM_ENGINE_DIGEST=

# The `kalam` role's password. Soma's migration creates the role with LOGIN and no
# password -- the credential is deployment configuration, so the committed migration
# ships no secret and the role cannot log in until this is set. On an existing volume,
# apply it with: devops/scripts/kalam-role-password.sh
KALAM_DB_PASSWORD=kalam-dev-secret

# ---- The replay store --------------------------------------------------------
# Locally these point at the `minio` service, which is a real S3 implementation, so
# the presigned PUT the wave does at every finish is exercised rather than stubbed.
# In a deployment they are R2's. A `finished` row REQUIRES replay_key -- the status
# shape check refuses one without it -- so this is not optional infrastructure.
R2_ENDPOINT=http://minio:9000
R2_BUCKET=tinybrains-replays
R2_ACCESS_KEY=tinybrains
R2_SECRET_KEY=tinybrains-dev-secret

# ---- Optional ----------------------------------------------------------------
# ORION_VERSION=1.7.0
# OAUTH_REDIRECT_URI=http://localhost:5173/v1/auth/github/callback
# APP_URL=http://localhost:5173/
# AXON_MEMORY_BUDGET_BYTES=1073741824
# AXON_IDLE_TTL_S=900

# Cookies: 0 sets [vars] cookie_secure = false so sign-in works over plain http
# on localhost. Set to 1 as soon as there is TLS in front.
SOMA_COOKIE_SECURE=0

# Orion's operations console (see the orion-ui service in docker-compose.yml);
# `latest` tracks the newest build.
ORION_UI_VERSION=1.6.0
