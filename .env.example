# Copy to .env and fill in. `docker compose` reads .env from this directory (devops/).
# The compose file refuses to start rather than defaulting any of the blanks.

# ---- GitHub OAuth App --------------------------------------------------------
# Create at github.com/settings/developers -> New OAuth App:
#   Homepage URL                 http://localhost:5173
#   Authorization callback URL   http://localhost:5173/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Soma --------------------------------------------------------------------
# HS256 key for session tokens and the sign-in state cookie. At least 32 bytes;
# generate one:
#   openssl rand -hex 32
SOMA_SESSION_SECRET=

# Cookies: 0 sets [vars] cookie_secure = false so sign-in works over plain http
# on localhost. Set to 1 as soon as there is TLS in front.
SOMA_COOKIE_SECURE=0

# ---- Postgres ----------------------------------------------------------------
POSTGRES_USER=soma
POSTGRES_PASSWORD=
POSTGRES_DB=soma

# The `kalam` role's password. Soma's migration creates the role with LOGIN and no
# password -- the credential is deployment configuration, so the committed migration
# ships no secret. The loader sets it on every `up`.
KALAM_DB_PASSWORD=kalam-dev-secret

# ---- The replay store --------------------------------------------------------
# Locally these point at the `minio` service, a real S3 implementation, so the
# presigned PUT the wave does at every finish is exercised rather than stubbed.
# In a deployment they are R2's. The loader makes the bucket.
R2_ENDPOINT=http://minio:9000
R2_BUCKET=tinybrains-replays
R2_ACCESS_KEY=tinybrains
R2_SECRET_KEY=tinybrains-dev-secret

# ---- Optional ----------------------------------------------------------------
# ORION_VERSION=1.7.0                # the server binary the orion image downloads
# ORION_UI_VERSION=1.6.0             # the console image; `latest` tracks the newest build
# OAUTH_REDIRECT_URI=http://localhost:5173/v1/auth/github/callback
# APP_URL=http://localhost:5173/
# AXON_MEMORY_BUDGET_BYTES=1073741824
# AXON_IDLE_TTL_S=900

# The engine digest is DERIVED from kalam/plugins/tb-ants/tb-ants.wasm by both the
# orion entrypoint and the loader, so it is never typed. Set it only to rehearse a
# rolling deploy; the loader refuses a value that disagrees with the file.
# KALAM_ENGINE_DIGEST=sha256:...

# The drain. Short on the one local server (see orion/orion.toml.tmpl); raise all
# four together to rehearse a replica finishing its wave before it stops.
# ORION_SHUTDOWN_DRAIN_SECS=5
# ORION_SHUTDOWN_FORCE_SECS=10
# ORION_CRON_SHUTDOWN_SECS=15
# ORION_STOP_GRACE=20s
