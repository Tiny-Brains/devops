# Orion server config for a KALAM REPLICA: the wave, and nothing else. Requires 1.7.0.
# Layer 07 §3, §4.2 and §6.2; the Soma+Jodi half is soma.toml.tmpl.
#
# One of these per replica. Each replica is disposable: it holds no state anything else needs, and
# a crash costs one wave, replayed from turn zero by the next claim.

[server]
host = "0.0.0.0"
port = 8080

# NO data_mounts. A replica binds no route -- it is cron only -- and that is the fact the drain
# numbers below turn on.

# THE DRAIN. Layer 07 §6.1 corrects what the build wrote down here, and the correction is the
# reason these two numbers are not what layer 03 §6 says.
#
# Read out of orion-server's main.rs, the shutdown sequence is:
#   1. /readyz -> 503
#   2. the HTTP server SLEEPS for shutdown_drain_secs -- tokio::time::sleep(drain).await, an
#      unconditional FIXED period, not a maximum
#   3. accepting stops; in-flight REQUESTS get up to shutdown_force_timeout_secs
#   4. then the supervised background tasks are stopped, under
#      tasks.shutdown(Duration::from_secs(config.server.shutdown_force_timeout_secs))
#      -- AND THE CRON WORKER IS ONE OF THOSE TASKS
#   5. inside that, the cron worker waits for in-flight occurrences under cron.shutdown_timeout_secs
#
# So the bound on a draining wave is min(cron.shutdown_timeout_secs, shutdown_force_timeout_secs):
# an INNER deadline under an OUTER one, and the cron key can only ever make it shorter. Setting
# cron to 2700 and leaving the server key at its 30 s default gives you 30 -- which is exactly what
# the build measured and mis-explained as "the smallest of three wins".
#
# shutdown_drain_secs therefore BUYS A REPLICA NOTHING: it exists so a load balancer's in-flight
# requests survive its own poll interval, and there is no balancer and no route here. It is also
# the one number paid UNCONDITIONALLY -- an idle replica pays it in full -- so raising it to the
# longest match, as the old rule implied, makes every scale-down cost a match duration whether or
# not a wave is in hand. It is small, and that is deliberate.
shutdown_drain_secs         = ${ORION_SHUTDOWN_DRAIN_SECS:-5}

# THE REAL BOUND ON A WAVE. Above channel_timeout_ms (2 400 s), so the channel gives up first.
shutdown_force_timeout_secs = ${ORION_SHUTDOWN_FORCE_SECS:-2700}

# NOT CLUSTER MODE, AND THAT IS THE CORRECTNESS HALF -- layer 07 §4.2, decision 41.
#
# A `forbid` singleton is a ROW in the state database. tb-wave declares
# {"policy": "forbid", "key": "wave"} -- one wave in flight per replica, which is what K bounds and
# what the loader's residency budget is sized for. Put N replicas over ONE shared state and that
# row becomes fleet-wide: EXACTLY ONE REPLICA WOULD EVER RUN A WAVE, and the other N-1 would poll
# every five seconds, find the singleton held, and look perfectly healthy. The fleet would scale to
# zero throughput with every dashboard green.
#
# So local SQLite per replica is not a saving over a managed Postgres; it is what makes each
# replica its own scheduler. Nothing is lost by it, because KALAM'S FENCE IS NOT ORION'S: its
# mutual exclusion is the database claim on `matches` -- FOR UPDATE SKIP LOCKED over the partial
# index, leased, with the lapse and reap of layer 01 §4 -- and that is shared state of the only
# kind Kalam needs. Orion's occurrence lease would recover a dead node's OCCURRENCE; the match
# lease recovers its ROWS, which is the thing that matters, and it already works.
#
# There is deliberately no [cluster] block at all.

[storage]
# Disposable by design: this database holds the loaded package and nothing else. Everything that
# matters is in Postgres. Losing it on a restart costs one package load, which is why the package
# is installed into each replica at init rather than baked into the image (layer 07 §8.2).
url = "sqlite:${ORION_STATE_PATH:-/var/lib/orion/state.db}"

# A single node migrates at boot, and that is what makes orion-server a single-binary install.
# entrypoint.sh runs `migrate` explicitly anyway, so this is belt and braces.
auto_migrate = true

[vars]
# ------------------------------------------------------------------------------- KALAM
# Layer 03 §6's numbers. PROVISIONAL, but measured rather than guessed. The wave workflow reads
# them by these names, so renaming one breaks the wave rather than defaulting it.

# The engine this replica plays, and the only rows its wave may claim. DERIVED, never typed:
# orion/entrypoint.sh hashes the vendored component and exports it, and the loader writes the same
# value into games.active_engine_digest. The claim statement filters on it, so a replica running an
# old engine drains its own rows across a rolling deploy and takes none of the new ones (finding 5
# option A) -- which is what makes the digest the CUTOVER SWITCH of layer 07 §9.
#
# scripts/check-configs.sh refuses a literal digest here. A pinned value that disagrees with the
# vendored file is the one failure that is silent everywhere: the wave claims nothing, for ever.
engine_digest = "${KALAM_ENGINE_DIGEST}"

# K, rows per wave. DECISION 5, taken in layer 07 §7.1 as a RESIDENCY BUDGET rather than a
# measurement: every candidate ceiling was measured and none binds -- not wave_state against the
# plugin ceiling, not Orion's per-turn cost, not inference -- but memory at the largest class does.
#
#     K x seats_per_match x max_class_bytes  <=  the replica's memory for weights
#
# At K=16, two seats and a `large` class of 64 MiB that is 2 GiB of resident weights in the worst
# case where every seat of every match is a distinct large model, which is the case affinity tries
# to avoid and cannot be relied on to. Moving K is arithmetic on that line -- and it moves DOWN for
# a fleet serving large models on small replicas, which the old framing never suggested. Keep
# AXON_MEMORY_BUDGET_BYTES on the axon beside this replica above the product.
wave_k = 16

# N, turns between lease renewals (decision 19), and the lease itself, about 9x the renew interval.
# A dead replica's rows return to the queue within one lease plus one poll.
renew_every_n_turns = 30
lease_seconds       = 300

# The turn clock, enforced by the loader, and the cap on a match's length. Both are the GAME's,
# from ants/cartridge.json `limits`, repeated here because a workflow cannot read the manifest.
# max_turns must stay below [engine] max_loop_iterations.
turn_ms   = 1000
max_turns = 1000

# The game's budgets.adapter_ops_max, passed on every /play call -- a parameter, which is what
# keeps the loader game-agnostic. Decision 6: measured at 1,000,000.
budget_ops = 1000000

# Missed turn clocks before a seat forfeits, counted cumulatively. EQUAL TO forfeit_strikes in
# soma.toml.tmpl, and since layer 07 that is a value in two files -- scripts/check-configs.sh
# asserts it. Kalam applies it; count reads its consequences off the row.
strike_ceiling = 5

# Refusals for want of loader memory before a row is unplayable. Distinct from lapses: memory
# pressure is transient and a row should outlive it.
refusal_ceiling = 5

# Where a replay lands: <prefix>/<match_id>/<claim_token>.json -- it names the ATTEMPT, so a stale
# attempt's blob is an orphan under its own key rather than a replacement (finding 7d).
replay_prefix = "replays"

# The replay store's endpoint, and the ONE value that must equal the kalam-blobs-put connector's
# base URL: the wave subtracts this string from the presigned URL to get a path for http_call.
# Soma's soma-blobs presigns GETs against the same store.
blob_endpoint = "${R2_ENDPOINT}"

# How often the claim channel looks for work. DECISION 25, taken in layer 07 §7.2 IN SHAPE ONLY:
# bounded below by claim load (N replicas at interval i issue N/i claims per second against the
# partial index on `pending`) and above by trial latency (a newly paired row waits up to i before
# any replica sees it, and that wait is on the front of every trial). Five seconds stands; THE
# CONSTANT THAT MOVES IT IS STILL OWED to the claim-under-load spike, tracker §3.1.
#
# The channel's cron expression carries the real value; this is here so a reader sees it beside
# the rest.
poll_secs = 5

# ------------------------------------------------------------------------------- plugins
# Off by default in Orion. tb.ants needs it; without this it loads as a row and quarantines the
# wave channel that names it. `cache_dir` is deliberately absent: reserved in 1.7.0, and a
# non-empty value is REFUSED at startup. Every ceiling is the host default -- 1 MiB request and
# response, 5 s, 64 MiB of linear memory; wave_state at K=64 is 55% of the request ceiling on the
# largest preset, so K=16 is 14% of it.
[plugins]
enabled = true

# Signing. Empty until P6 mints the keys: with public_keys non-empty an upload must carry a
# signature over the component digest by one of them, verified again at every load. THE CARTRIDGE
# IS THE ONE PLACE A THIRD PARTY'S CODE ENTERS THE PLATFORM, so this must be non-empty before a
# second cartridge by an outsider ships (P7). Layer 07 §11.
[plugins.trust]
public_keys = []

[cron]
# The INNER deadline on a draining wave; the outer one is shutdown_force_timeout_secs above. Equal
# to it, so neither surprises. Above channel_timeout_ms either way.
shutdown_timeout_secs = ${ORION_CRON_SHUTDOWN_SECS:-2700}

[engine]
# Bounds the wave workflow's per-turn loop. Above max_turns by a wide margin: hitting this is a
# runaway, not a long match.
max_loop_iterations = 10000

# Trace persistence. The wave channel carries `errors_only: true`, so a clean wave of hundreds of
# turns writes no trace and a broken one is kept in full -- which is the only reason `sync` is
# affordable on a channel that is ~3000 task executions per run.
[trace_storage]
mode = "sync"
