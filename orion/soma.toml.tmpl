# Orion server config for the SOMA+JODI unit: the REST surface and the four clocks, in CLUSTER
# MODE. Requires 1.7.0. Layer 07 §3 and §4.1; the Kalam half is kalam.toml.tmpl.
#
# Every ${NAME:-default} below is substituted by orion-server from the container's environment
# before the file is parsed -- Orion's own config syntax -- so one image serves every environment
# and nothing is written to disk. Only non-secret values are read that way; a credential is an
# env:// reference the server resolves itself, after parsing.
#
# It is valid TOML as it stands: `orion-server -c soma.toml.tmpl validate-config` and
# `orion-server clippy <package> -c soma.toml.tmpl` read it with the defaults applied.
#
# TWO PACKAGES, ONE [vars] BLOCK, SECTIONED BY OWNER. This was one file for all three packages
# until layer 07; Kalam's section moved to kalam.toml.tmpl unchanged, which is exactly what the old
# file's header promised would happen. What the split creates is a value in TWO files that must
# agree -- there are three, they are listed in layer 07 §3, and scripts/check-configs.sh asserts
# them. A rule that lives only in a comment is one rebase from being wrong.

[server]
host = "0.0.0.0"
port = 8080

# Soma's channels declare route_pattern "/v1/...", and the full request path is matched against
# the pattern -- so the "/v1" prefix appears in both places. Jodi is cron only and binds no route.
data_mounts = ["/v1"]

# THE DRAIN -- layer 07 §6.2. This unit sits behind a load balancer and serves requests, which is
# exactly what shutdown_drain_secs is for: /readyz flips to 503, and the node keeps serving for
# this fixed period so requests the balancer routes here during its own poll interval still
# succeed. Thirty seconds is Orion's default and the right order for an LB poll.
#
# shutdown_force_timeout_secs is a MAXIMUM (in-flight requests) and is also the outer deadline on
# the supervised background tasks -- see the long note in kalam.toml.tmpl, where it matters.
# Nothing here runs for minutes: a clock's occurrence is seconds of SQL and one plugin call.
#
# The orchestrator's grace must exceed drain + force = 60. compose sets 90.
shutdown_drain_secs         = ${ORION_SHUTDOWN_DRAIN_SECS:-30}
shutdown_force_timeout_secs = ${ORION_SHUTDOWN_FORCE_SECS:-30}

# CLUSTER MODE IS A REQUIREMENT HERE, NOT A SCALING CHOICE -- layer 07 §4.1.
#
# Jodi's four clocks are cluster-wide singletons, and a `forbid` singleton is a ROW in the state
# database held by one occurrence at a time. So "cluster-wide" is the same thing as
# "state-database-wide": two Orions over one orion_state are one scheduler, and two over two are
# two schedulers. Run this unit at N=2 without cluster mode and you get two tb-count clocks folding
# the same finished matches -- which the fence in `clocks` makes SAFE but not ONCE.
#
# It needs two shared backends and refuses to start without them: Postgres or MySQL (sqlite: is
# refused, a file being single-host by construction) and a Redis.
[cluster]
enabled                = ${ORION_CLUSTER_ENABLED:-true}
redis_url              = "env://REDIS_URL"
epoch_poll_interval_ms = 2000
# Stable per replica so Kafka static membership survives a restart; empty generates one per boot.
instance_id            = "${ORION_INSTANCE_ID:-}"

# Orion's own state: channels, workflows, plugins, cron occurrences, traces. NOT Soma's data --
# a separate database on the same Postgres, so `psql -d soma` never shows engine tables and Soma's
# schema can be dropped without losing the loaded packages.
[storage]
url = "env://ORION_STATE_DB_URL"

# A CLUSTER MAY NOT MIGRATE AT BOOT: cluster.enabled with auto_migrate is refused at startup in
# production and warned about everywhere else. entrypoint.sh runs `orion-server migrate` before
# the server starts, which is the deploy step this asks for, so this is false and stays false.
auto_migrate = false

[vars]
# ------------------------------------------------------------------------------- SOMA
# Read by the workflows as metadata.vars and by the sign-in channel as var://. The URL defaults are
# the localhost stack; a deployment sets the variables.
app_url            = "${APP_URL:-http://localhost:5173/}"

# The OAuth App's Authorization callback URL, exactly as registered with GitHub. https only,
# except on a loopback host -- Orion refuses anything else at load.
oauth_redirect_uri = "${OAUTH_REDIRECT_URI:-http://localhost:5173/v1/auth/github/callback}"

# Whether the session and oauth-state cookies carry Secure. Must substitute to a bare TOML boolean;
# orion/entrypoint.sh normalises SOMA_COOKIE_SECURE (0/false/no -> false, anything else -> true)
# before the server reads it. Browsers will not store a Secure cookie from an http:// origin, so a
# plain-http stack sets false; anything behind TLS must be true. Layer 07 §11: this is the first
# thing that must be true of any origin that is not loopback.
cookie_secure      = ${SOMA_COOKIE_SECURE:-true}

# Layer 06 rule 3: the next season's submission window may open no sooner than this many days
# after the previous season closed. Read by POST /v1/games/{game}/seasons. Soma also reads
# prior_mu and prior_sigma from Jodi's block below, for the baselines it carries into a new season;
# THE DAY SOMA GETS A SERVER OF ITS OWN it needs its own copy, equal to Jodi's, and
# scripts/check-configs.sh already has that fourth case in it (layer 07 §16.4).
season_gap_days    = ${SEASON_GAP_DAYS:-1}

# ------------------------------------------------------------------------------- JODI
# 02-jodi.md §9's numbers, every one PROVISIONAL: policy guesses only a running ladder can tune.
# They live here rather than in the definitions because a definition is versioned and
# content-hashed -- changing a pairing rate should not be a new workflow version. Layer 06
# finalises the rating numbers; when one must change without a deploy they move to a `policies`
# table (jodi-gaps 4.7).

# The game the clocks run for. One game today; a second makes this a roster.
game = "ants"

# The presets a match may be played on, each with the number of seats it is played at. THE PRESET
# DECIDES THE SEAT COUNT (decision 14): a preset names a world and how many play it. Pair spreads
# a version's matches across these so a rating reflects the game rather than one map. P3 makes the
# cartridge manifest the source of this list.
presets = [
  { name = "standard", players = 2 },
  { name = "maze",     players = 2 },
  { name = "cell",     players = 2 },
]

# count: matches folded per run. pair: how deep the pending queue may get -- a staleness cap,
# never the signal; demand is the signal. LAYER 07 §5: this is also why the autoscaler must never
# read queue depth -- pair_depth_target caps the queue, so depth would cap the fleet at
# pair_depth_target/wave_k and look correct doing it.
count_batch       = 50
pair_depth_target = 64

# The in-flight policy (decision 1, 02-jodi.md §4): `burst` matches at once for a new version,
# `steady_cap` once placed, none of its own once its sigma is at or below `settled_sigma`.
burst         = 8
steady_cap    = 2
settled_sigma = 3.0

# One match in five crosses weight classes, which keeps `open` one connected graph.
cross_class_fraction = 0.20

# Platform failures on one candidate before it is refused UNPLAYABLE.
repair_cap = 3

# Missed turn clocks before a seat forfeits (DESIGN.md §7). Kalam APPLIES this as strike_ceiling
# in kalam.toml.tmpl; count reads its consequences off the row. THE TWO MUST STAY EQUAL, and since
# layer 07 they are in two files -- scripts/check-configs.sh asserts it. A disagreement makes count
# judge a trial by a rule the wave did not play by.
forfeit_strikes = 5

# The rating prior, and what a promoted version inherits. prior_mu and prior_sigma must stay equal
# to the numbers db-init/30-seed.sql gives the baselines, since a baseline's first fold reads those
# as its own prior. Soma's season create reads them too, from this block, which is safe only while
# Soma and Jodi share a config -- see season_gap_days above.
prior_mu        = 25.0
prior_sigma     = 8.333333333333334
sigma_inflation = 2.0

# TrueSkill's parameters, passed to the plugin on every call. beta is prior_sigma/2, tau is
# prior_sigma/100 -- the dynamics factor that re-opens a settled version's uncertainty over time.
ts_beta             = 4.166666666666667
ts_tau              = 0.08333333333333333
ts_draw_probability = 0.10

# --- admission (layer 08 §11, Jodi's fourth clock). NOT HERE, ON PURPOSE: adapter_ops_max and
# flop_caps, which are the GAME's, read from games.manifest (decision 38); and the size-class
# thresholds, which are platform-wide and live in the judging task.

# Where a release's two assets -- model.onnx and adapter.json, decision 17 -- are fetched from. A
# deployment fact rather than policy; what may actually be dialled is AXON_FETCH_ALLOW_HOSTS on the
# admission loader, the one process with an allowlist.
release_base = "${RELEASE_BASE:-https://github.com/}"

# Submissions one run may claim; how long a claim holds before another run may re-claim; attempts
# before TIMED_OUT. The bound is `zstd -19` on 96 MiB of initializers, not inference. Verification
# only -- a trial row never times out the candidate; that is count's repair_cap.
admit_batch        = 4
admit_timeout_s    = 180
admit_attempts_max = 3

# Per-observation deadline passed to /validate.
admit_deadline_ms = 5000

# The re-validation sweep's batch (layer 08 §9). Zero disables it.
revalidate_batch = 4

# The season's opset pin and the operator allowlist -- DESIGN.md §5's ops. The loader REPORTS a
# graph's operators and this list JUDGES them, which keeps a policy change out of axon's release
# cycle.
opset_min = 13
opset_max = 19
op_allowlist = [
  "Abs", "Add", "And", "ArgMax", "ArgMin", "AveragePool", "BatchNormalization", "Cast", "Ceil",
  "Clip", "Concat", "Constant", "ConstantOfShape", "Conv", "Div", "Elu", "Equal", "Erf", "Exp",
  "Expand", "Flatten", "Floor", "Gather", "GatherElements", "Gemm", "GlobalAveragePool",
  "GlobalMaxPool", "Greater", "HardSigmoid", "Identity", "InstanceNormalization", "LayerNormalization",
  "LeakyRelu", "Less", "Log", "LogSoftmax", "MatMul", "Max", "MaxPool", "Mean", "Min", "Mul", "Neg",
  "Not", "Or", "Pad", "Pow", "PRelu", "Range", "Reciprocal", "ReduceMax", "ReduceMean", "ReduceMin",
  "ReduceSum", "Relu", "Reshape", "Resize", "Selu", "Shape", "Sigmoid", "Sign", "Slice", "Softmax",
  "Softplus", "Split", "Sqrt", "Squeeze", "Sub", "Sum", "Tanh", "Tile", "Transpose", "Unsqueeze",
  "Where",
]

# ------------------------------------------------------------------------------- plugins
# Off by default in Orion. Jodi's tb.rating and tb.pairing need it; without this they load as rows
# and quarantine the clocks that name them. `cache_dir` is deliberately absent: reserved in 1.7.0,
# and a non-empty value is REFUSED at startup. tb.ants is NOT loaded here -- it is Kalam's, and
# this unit plays no matches.
# ---------------------------------------------------------------------------- the admin plane
#
# THE ADMIN CREDENTIAL IS THE TRUST ROOT FOR INSTALLING ANYTHING. It reads and writes connector
# secrets and can rewrite any workflow, so it outranks the plugin signature above -- a signature is
# a check that survives the upload, not a second principal. Layer 07 §11 gates this on "before
# anything is reachable off loopback": locally every admin port is bound to 127.0.0.1, and the
# moment a loader has to reach a replica across a network that stops being true.
#
# An entry is either the key or `sha256:<64 hex>` of it, so a deployment keeps a digest in config
# and the secret in its orchestrator's store. A plaintext key must be at least 32 characters;
# `openssl rand -hex 32` gives 64. Multiple entries exist for zero-downtime rotation: add the new
# key, roll the clients, drop the old one.
[admin_auth]
enabled = true
api_keys = ["${ORION_ADMIN_KEY}"]

[plugins]
enabled = true

# Signing. This unit loads only plugins we wrote -- tb.rating and tb.pairing; the cartridge, which
# is the one place a third party's code enters the platform, loads on Kalam. The list is non-empty
# on BOTH units on purpose: a half-configured trust posture is worse than none, because it is the
# unchecked node you forget. Layer 07 §11.
#
# Same mechanism as Kalam's block: a detached Ed25519 signature over the digest string
# `sha256:<64 hex>`, verified at upload and again at every load. Minted by
# `devops/scripts/trust-keygen.sh`, applied by `devops/scripts/sign-plugins.sh`.
#
# One key serves both units today. Whether the cartridge and the platform's own plugins should
# share a trust root at all is decision 31, still open and forced at P7 -- keeping this a per-unit
# list is what leaves that decision free to go either way.
[plugins.trust]
public_keys = ["${TB_TRUST_PUBLIC_KEY}"]

[cron]
# How long shutdown waits for an in-flight occurrence. An INNER deadline under
# server.shutdown_force_timeout_secs -- layer 07 §6.1 -- so it can only ever make the wait shorter,
# never longer. Jodi's clocks are seconds of SQL, so a minute is generous.
shutdown_timeout_secs = ${ORION_CRON_SHUTDOWN_SECS:-60}

# Governs the portable data dialect. Soma reaches Postgres through raw db_read instead, so these do
# not bind its endpoints; set so a dialect task added later inherits sane numbers.
[query]
default_limit = 50
max_limit     = 200

# Trace persistence. `sync` writes the trace inside the request path -- 2.1 ms median on GET
# /v1/games -- and is the strongest durability at a volume where the cost is nothing. Jodi's four
# clocks carry `errors_only: true` per channel, so a clean run writes no trace and a broken one is
# kept in full.
[trace_storage]
mode = "sync"
