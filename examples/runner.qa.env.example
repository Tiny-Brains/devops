# A QA RUNNER's settings. It plays for the QA stack (compose/web.qa.yml) and reuses
# compose/runner.prod.yml unchanged -- only the environment and the project name differ, and `tb`
# is what holds those two together:
#
#   cp examples/runner.qa.env.example qa/kalam/.env
#   ./tb qa runner up -d
#   ./tb qa runner --profile admit up -d   # nothing is admitted on QA until an admitting runner is up
#
# THE PROJECT IS NOT OPTIONAL, which is why `tb` holds it. compose/runner.prod.yml declares
# `name: tinybrains-runner-prod`, so running that file by hand without `-p tinybrains-runner-qa`
# makes this stack REPLACE the production runner on this machine -- same containers, QA's
# environment. The production runner would come back only when someone noticed and re-ran it.
#
# A QA RUNNER MUST BE BUILT FROM THE SAME ANTS RELEASE AS THE QA STACK'S SOMA, exactly as in
# production. The candidate's engine is usually NOT production's, which is why this runner's
# KALAM_IMAGE, its signatures directory and its models bucket are all separate below.

# ---- what makes this machine a QA runner -----------------------------------------------------------
# Minted on the QA stack's admin Runners page (https://<QA_HOST>/admin/runners), shown once.
# A production runner key does not work here and must never be pasted here: the two stacks have
# different RUNNER_TOKEN_SECRETs, and a key is only ever valid for the stack that minted it.
RUNNER_KEY=
# The machine's name on QA's Runners page. Say QA in it -- this is read beside production's list
# when you are tired.
RUNNER_LABEL=Mac-mini-qa

# ---- the QA deployment, copied from qa/web/.env ------------------------------------------------------
# https://<QA_HOST>
SOMA_URL=
# The SAME string as production's: one account, one S3 endpoint. The buckets are what differ.
R2_S3_ENDPOINT=
MODELS_BUCKET=tinybrains-models-qa
# A read-only token on the QA models bucket ALONE (Object Read, tinybrains-models-qa). Not the
# production runner's token, and not the QA stack's read-write one.
MODELS_READ_ACCESS_KEY=
MODELS_READ_SECRET_KEY=
# The machine's one trust root: the same value as production's, because a signature belongs to
# whoever holds the key.
TB_TRUST_PUBLIC_KEY=
# THE QA SIGNATURES, not production's. The two stacks' images carry different engines, so
# `tb-ants.wasm.sig` is a different signature in each directory -- pointed at the wrong one, this
# runner's boot apply quarantines the channels that call the plugin and stops the node.
#   on the VM: TB_ENV=qa scripts/setup/sign-plugins.sh prod/web/keys/tinybrains-dev.pem
#   then copy qa/web/keys/signatures/ from the VM to qa/kalam/keys/signatures/ here
# RELATIVE TO compose/, NOT TO devops/. A bind mount's relative source is resolved against the
# compose file's own directory, so `./keys/signatures` here means devops/compose/keys/signatures --
# a path that does not exist, which Docker then CREATES EMPTY, and the node stops at its boot apply
# with no signature for a plugin it must load. Every environment's value begins `../<env>/`.
RUNNER_SIG_DIR=../qa/kalam/keys/signatures

# The candidate runner release, built from the same ants release as the QA stack's Soma.
#   KALAM_IMAGE=ghcr.io/tiny-brains/kalam:<version>
KALAM_IMAGE=

# ---- this machine's own ------------------------------------------------------------------------------
#   openssl rand -hex 32   -- and not the production runner's key
ORION_ADMIN_KEY=

# ---- capacity: SMALL, because production is the tenant that matters ----------------------------------
# This runner shares a machine with the production runner. One slot and two workers is enough to
# prove a candidate plays; it is not enough to starve production of CPU while a season is live.
RUNNER_CRON_WORKERS=2
RUNNER_SEAT_CONCURRENCY=2
RUNNER_MAX_CACHE_BYTES=1073741824
RUNNER_MAX_LOADED_BYTES=536870912
RUNNER_CPUS=2
#RUNNER_MATCH_TIMEOUT_MS=
#RUNNER_MEMORY=0
# The QA admitting runner. Its admin port must not collide with the production runner's 8091.
ADMIT_CPUS=1
ADMIT_ADMIN_PORT=8092
#ADMIT_MEMORY=0
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
