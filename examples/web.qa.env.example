# THE QA PLATFORM'S SETTINGS, for docker-compose.qa.yml. On the production machine this file becomes
# .env.qa -- `cp .env.qa.example .env.qa` -- and every QA command names it:
#
#   docker compose -f docker-compose.qa.yml --env-file .env.qa <cmd>
#
# QA RUNS BESIDE PRODUCTION ON THE SAME MACHINE AND THE SAME POSTGRES SERVER. It has its own
# databases, its own buckets, its own Redis and its own OAuth App; it shares the VM, the Postgres
# instance, the edge (production's caddy) and the trust key. README, *A QA stack beside production*,
# is the order these are filled in, and scripts/setup/qa-secrets.sh writes the minted ones.
#
# THE TWO VALUES THAT REACH PRODUCTION IF YOU GET THEM WRONG are marked !! below. Everything else in
# this file is QA's alone.

# ---- the site ------------------------------------------------------------------------------------
# The QA hostname. Its DNS A record points at this machine BEFORE the first `up`: production's caddy
# fetches the certificate for it, from the block in compose/caddy/conf.d/qa.caddy.
QA_HOST=
# The console is https://<QA_HOST>:9443 -- a different port from production's 8443, because both
# stacks answer on the same caddy.

# ---- the releases this stack runs ----------------------------------------------------------------
# The candidate. This is the whole point of the stack, so these are usually AHEAD of .env's.
#   SOMA_IMAGE=ghcr.io/tiny-brains/soma:<version>
#   WEB_IMAGE=ghcr.io/tiny-brains/web:<version>
# Both must be built from ONE ants release, as in production.
SOMA_IMAGE=
WEB_IMAGE=
#ORION_UI_VERSION=1.9.1

# ---- the QA GitHub OAuth App ---------------------------------------------------------------------
# A SECOND App, not production's: the callback is per-host and a shared secret would let a QA bug
# mint a credential the production App trusts. github.com/settings/developers -> New OAuth App:
#   Homepage URL                 https://<QA_HOST>
#   Authorization callback URL   https://<QA_HOST>/v1/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- who is an admin here ------------------------------------------------------------------------
# `provider:subject` pairs, comma-separated (`github:<id>`). This is the guest list: the developers
# you are letting onto the candidate go here, and they are admins OF QA ONLY.
#   scripts/setup/admin-user.sh <github-login> --env-file .env.qa
SOMA_ADMIN_IDS=

# ---- secrets, minted on this machine ---------------------------------------------------------------
# scripts/setup/qa-secrets.sh writes all five. Four are QA's own; the fifth is not.
#
# !! RUNNER_GATE_DB_PASSWORD MUST EQUAL PRODUCTION'S, character for character.
#    `runner_gate` is a PostgreSQL ROLE, and roles are cluster-wide: one role serves both databases
#    on this server. soma's bootstrap runs `ALTER ROLE runner_gate WITH LOGIN PASSWORD` on every
#    bring-up, so a QA bootstrap holding a different value SILENTLY CHANGES PRODUCTION'S GATE
#    PASSWORD -- every runner then fails to connect, and nothing in production's logs names QA.
#    qa-secrets.sh copies the value out of .env and scripts/setup/qa-db.sh refuses to run if the two
#    have drifted. Do not edit this line by hand.
#
# TB_TRUST_PUBLIC_KEY is shared with production on purpose: one machine, one trust root, and the
# signatures are per COMPONENT DIGEST, not per stack. QA's are signed into keys/signatures-qa/
# because QA's images carry a different engine -- see qa-secrets.sh.
ORION_ADMIN_KEY=
TB_TRUST_PUBLIC_KEY=
SOMA_SESSION_SECRET=
RUNNER_TOKEN_SECRET=
RUNNER_GATE_DB_PASSWORD=

# ---- Postgres: THE SAME SERVER, TWO MORE DATABASES -------------------------------------------------
# Same host, same owner role, same `?sslmode=require` as .env -- only the database names differ.
# scripts/setup/qa-db.sh creates both; they do not appear on their own, because soma's bootstrap
# creates only the literal `orion_state` (which production already owns) and migrates into whatever
# ORION_STATE_DB_URL names.
#   SOMA_DB_URL          postgres://<owner>:<password>@<host>:5432/soma_qa?sslmode=require
#   ORION_STATE_DB_URL   postgres://<owner>:<password>@<host>:5432/orion_state_qa?sslmode=require
#   SOMA_ADMIN_DB_URL    postgres://<owner>:<password>@<host>:5432/postgres?sslmode=require
#   RUNNER_GATE_DB_URL   postgres://runner_gate:<RUNNER_GATE_DB_PASSWORD>@<host>:5432/soma_qa?sslmode=require
# RUNNER_GATE_DB_URL names soma_qa and carries the SHARED password above. The gate's grants are
# per-database, so this connection reaches QA's tables and nothing of production's.
SOMA_DB_URL=
ORION_STATE_DB_URL=
SOMA_ADMIN_DB_URL=
RUNNER_GATE_DB_URL=

# ---- Cloudflare R2: THE SAME ACCOUNT, TWO MORE BUCKETS ---------------------------------------------
# !! SEPARATE BUCKETS, NEVER PRODUCTION'S. A QA runner writes replays and a QA admission reads
#    models by digest; pointed at production's buckets it would write into them, and the object it
#    overwrites is a real competitor's. Make them in the Cloudflare dashboard (R2 -> Create bucket),
#    both PRIVATE, CORS allowing https://<QA_HOST>, and a short expiry on replays/ -- QA replays are
#    disposable.
#
# The endpoint is the ACCOUNT's, so it is the same string as .env's: buckets are addressed by name,
# not by host. Every QA runner's R2_S3_ENDPOINT is this exact string too.
R2_S3_ENDPOINT=
R2_BUCKET=tinybrains-replays-qa
MODELS_BUCKET=tinybrains-models-qa
# A SECOND R2 API token, scoped to Object Read & Write on the two -qa buckets and nothing else.
# Production's token must not reach QA and QA's must not reach production: that scoping is the only
# thing standing between a QA bug and a competitor's model.
R2_ACCESS_KEY=
R2_SECRET_KEY=

# ---- sizing, which is where the saving is ----------------------------------------------------------
# QA shares an e2-small's RAM and a db-f1-micro's 60 connections with production. Production's node
# takes 8 + 4 + 15 = 27; these leave it alone.
#
# THE POSTGRES BUDGET: 4 + 2 to soma_qa, 6 to orion_state_qa = 12. With production's 27 that is 39
# of 60, which leaves room for a restart overlapping and for a psql session of your own.
SOMA_DB_MAX_CONNECTIONS=4
SOMA_GATE_DB_MAX_CONNECTIONS=2
SOMA_STATE_DB_MAX_CONNECTIONS=6
SOMA_STATE_DB_MIN_CONNECTIONS=1
# RAM. Production's soma is capped at 1g; 512m is enough for a handful of developers, and on a 2 GB
# e2-small the two together still leave the caddy, two webs and four Redis containers room. If you
# bump the VM to e2-medium, raise this first.
SOMA_MEMORY=512m
CACHE_MAXMEMORY=64mb
# Logs rotate harder here: QA is the stack that gets left running while nobody watches it.
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# SOMA_CRON_WORKERS is deliberately NOT lowered. Five clocks are declared and the admit clock can
# hold a worker for its full 600 s; below four, pair/count/withdraw/reap queue behind it and QA
# looks like an idle ladder on a healthy node -- the exact failure you would be here to catch.

# ---- optional --------------------------------------------------------------------------------------
# QA's own subnet. It must not collide with PLATFORM_SUBNET in .env (172.29.250.0/24 by default).
#QA_SUBNET=172.29.251.0/24
# Production's compose network, which QA's web joins so production's caddy can reach it by name.
# `<project>_<network>`: the project is the `name:` in docker-compose.prod.yml.
#PROD_NETWORK=tinybrains-prod_platform
#PLATFORM_SUBNET=172.29.250.0/24
#ENGINE_RELEASE=0
#SOMA_ALLOW_PRIVATE_URLS=false
#ORION_RUST_LOG=info,dataflow_rs::engine::workflow_executor=warn,dataflow_rs::engine::functions::filter=warn,orion::server::observability=warn
