      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (channel) (rate(orion_response_cache_hits_total[$__rate_interval])) / (sum by (channel) (rate(orion_response_cache_hits_total[$__rate_interval])) + sum by (channel) (rate(orion_response_cache_misses_total[$__rate_interval])))",
