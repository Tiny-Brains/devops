    {
      "id": 11,
      "title": "Swap paging",
      "type": "timeseries",
      "datasource": {
        "type": "stackdriver",
        "uid": "cloudmonitoring"
      },
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloudmonitoring"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/swap/pages_swapped_in_count",
              "AND",
              "resource.label.database_id",
              "=",
              "$instance"
            ],
            "groupBys": [],
            "perSeriesAligner": "ALIGN_RATE",
            "crossSeriesReducer": "REDUCE_NONE",
            "alignmentPeriod": "cloud-monitoring-auto",
            "preprocessor": "none",
            "view": "FULL"
          },
          "aliasBy": "in"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "stackdriver",
            "uid": "cloudmonitoring"
          },
          "queryType": "timeSeriesList",
          "timeSeriesList": {
            "projectName": "$project",
            "filters": [
              "metric.type",
              "=",
              "cloudsql.googleapis.com/database/swap/pages_swapped_out_count",
