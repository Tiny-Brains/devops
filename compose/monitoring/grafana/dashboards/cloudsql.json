        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(last_over_time(stackdriver_cloudsql_database_cloudsql_googleapis_com_database_cpu_reserved_cores{database_id=\"$instance\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "The tier's vCPUs. Shared-core tiers (db-f1-micro, db-g1-small) report 1 here and are throttled to a fraction of it."
    },
