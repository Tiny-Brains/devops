    {
      "id": 6,
      "title": "Swap used",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(last_over_time(stackdriver_cloudsql_database_cloudsql_googleapis_com_database_swap_bytes_used{database_id=\"$instance\"}[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1048576
              },
              {
                "color": "red",
                "value": 52428800
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "description": "Should be zero. Any swap means the working set no longer fits in memory, and it is how a tier that is too small runs out: queries slow by an order of magnitude long before anything fails."
    },
    {
      "id": 7,
      "title": "Connections",
