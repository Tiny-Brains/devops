# ---------------------------------------------------------------------------
# GRAFANA BEHIND THE SITE'S GITHUB SIGN-IN -- the Orion console's gate
# (compose/orion-ui/default.conf.template), around Grafana instead of a SPA.
#
# Every request is let through only after Soma's /v1/admin-check answers 204
# for the browser's `soma_session` cookie: 401 is no or a revoked session,
# 403 a signed-in non-admin. The cookie is host-only and cookies ignore the
# port, so a sign-in made on the site reaches this port too. Access is
# therefore `users.role = 'admin'`, decided on the site's Users admin page.
#
# AFTER SIGNING IN YOU LAND ON THE SITE, NOT BACK HERE. Soma's sign-in only
# returns to APP_URL or CONSOLE_URL (Orion matches `next` by exact origin,
# port included), and widening that list is a package change. Open Grafana
# again once signed in.
#
# Every variable is named GATE_*: NGINX_ENVSUBST_FILTER passes only those, so
# nginx's own `$host` and friends survive envsubst.
# ---------------------------------------------------------------------------

# The verdict, cached per session cookie. Grafana fires many requests a
# dashboard; each would otherwise be a Soma request and a database round trip.
proxy_cache_path /var/cache/nginx/authz levels=1:2 keys_zone=authz:1m
                 max_size=8m inactive=60s use_temp_path=off;

# Grafana Live is a websocket.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_tokens off;

    # Upstreams through variables, resolved per request: compose hands out a
    # new address on every recreate, and a name resolved once at load goes on
    # pointing at whatever container inherits the old one.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location = /_gate_health {
        access_log off;
        return 200 "ok\n";
    }

    location = /_authz {
        internal;
        set $gate_soma ${GATE_SOMA_URL};
        proxy_pass $gate_soma/v1/admin-check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;

        proxy_cache authz;
        proxy_cache_key $cookie_soma_session;
        proxy_cache_valid 204 10s;
        proxy_cache_valid 401 403 5s;
        proxy_cache_use_stale off;
    }

    location / {
        auth_request /_authz;
        error_page 401 = @signin;
        error_page 403 = @forbidden;

        set $gate_grafana ${GATE_GRAFANA_URL};
        proxy_pass $gate_grafana;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header X-Forwarded-Proto https;
        # WHO GRAFANA THINKS YOU ARE, set here and only here: whatever a browser sent under these
        # names is replaced. One shared user, because admin-check says yes or no, not who.
        proxy_set_header X-WEBAUTH-USER site-admin;
        proxy_set_header X-WEBAUTH-ROLE Admin;
        proxy_read_timeout 300s;
    }

    location @signin {
        add_header Cache-Control "no-store" always;
        return 302 "${GATE_SIGNIN_URL}?next=${GATE_SITE_URL}";
    }

    location @forbidden {
        default_type text/html;
        return 403 '<!doctype html><meta charset="utf-8"><title>Not for you</title><style>body{font:14px/1.6 system-ui;margin:12vh auto;max-width:34rem;padding:0 1.5rem;color:#1a1a1a}code{background:#f2f2f2;padding:.1em .35em;border-radius:3px}</style><h1>Monitoring is for administrators</h1><p>You are signed in, but Grafana is limited to administrators, decided by <code>users.role</code> on the site&rsquo;s Users admin page.</p>';
    }
}
