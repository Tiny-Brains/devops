  "cards": [
    {
      "dot": "cyan",
      "title": "Orion on both sides",
      "items": [
        "The API, the runner gate and the clocks are one central Orion node running the soma package",
        "Each runner is its own Orion node: it admits a model with Orion's own admission, then probes it",
        "A match is an Orion workflow on the runner: tb-ants worldgen, observe and step, and model_infer per seat"
      ]
    },
    {
      "dot": "amber",
      "title": "A clock tick between steps",
      "items": [
        "admit every 20 s, pair 15 s, count 10 s, reap 5 s, withdraw every minute",
        "The roster lists only versions that already have seats, so a new version reaches a runner after pairing",
        "A runner that has not registered a seat's model releases the claim, and the match is claimed again later"
      ]
    },
    {
      "dot": "rose",
      "title": "Fenced, not trusted",
      "items": [
        "Every gate write is fenced on the claim token and its lease",
        "Reap returns a lapsed lease to pending; the third lapse fails the match",
        "An admission gets 3 attempts, then PROBE_TOO_SLOW or TIMED_OUT"
      ]
    },
    {
      "dot": "emerald",
      "title": "Who decides",
      "items": [
        "Kalam reports facts; Soma's clocks decide admission, pairing, rating and promotion",
        "Soma runs no model and never parses the ONNX",
        "Runners reach the gate through Caddy and web, like a browser"
      ]
    }
  ]
